# ── Google Gemini API (AI comment analysis) ──────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── MongoDB ──────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=LeadAI
# Comma-separated DNS servers for mongodb+srv:// SRV resolution (optional)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ── Apify (social data source) ───────────────────────────────────────────
# From https://apify.com/account/integrations
APIFY_API_TOKEN=

# ── Optional: non-Facebook platform actors (URL search) ──────────────────
# Leave empty to disable that platform.
INSTAGRAM_ACTOR_ID=apify/instagram-scraper
YOUTUBE_ACTOR_ID=streamers/youtube-scraper
LINKEDIN_ACTOR_ID=harvestapi/linkedin-company
LINKEDIN_POSTS_ACTOR_ID=harvestapi/linkedin-company-posts

# ── Optional: comment collection limits ──────────────────────────────────
# Maximum comments to collect per URL-search run (default: 100)
# MAX_COMMENTS_TO_COLLECT=100

# ── Server ────────────────────────────────────────────────────────────────
API_PORT=8000

# ══ SUPER ADMIN — PERMANENT PLATFORM OWNER (REQUIRED) ═════════════════════
# The ONLY login credentials configured through the environment. On Render,
# set both under your service → Environment. They sign in to /superadmin
# (at /login?superadmin=1) and are read from the environment only: they
# cannot be changed, reset or overridden from inside the app.
#   SUPERADMIN_PASSWORD: a long, unique password (12+ characters), or a
#   bcrypt hash of it ($2b$...), created with:
#   python -c "from app.auth.crypto import hash_password; print(hash_password('YourPassword'))"
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ── Admins and users: NOT configured here ─────────────────────────────────
# Organization admins, managers, users and viewers are database accounts,
# created through demo signup and invitation links (Super Admin portal →
# Organizations, or Org Admin portal → Team). Never add their emails or
# passwords as environment variables.

# ── Deprecated (optional, leave empty on new deployments) ─────────────────
# PANEL_ADMIN_EMAIL / PANEL_ADMIN_PASSWORD_HASH: old name for the Super
# Admin, used only when SUPERADMIN_EMAIL is not set.
# ADMIN_EMAIL / ADMIN_PASSWORD_HASH: old single-site login. If set, the
# startup migration copies the hash onto that user's database account once;
# sign-in itself is database-only, so you can remove them afterwards.
# PANEL_ADMIN_EMAIL=
# PANEL_ADMIN_PASSWORD_HASH=
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=

# ── Session security ──────────────────────────────────────────────────────
# Long random string used to sign session cookies.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# REQUIRED for production — without it sessions invalidate on every restart.
SESSION_SECRET=
# Encrypts customers' own Apify / Gemini keys at rest (API keys & plan).
# A Fernet key or any long passphrase. Set it once and keep it: changing it
# makes saved customer keys unreadable (they must be entered again).
# Without it, a key derived from SESSION_SECRET is used.
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=
# Session lifetime in days (absolute expiry)
SESSION_TTL_DAYS=7
# Idle session timeout in minutes (0 disables, default 30)
SESSION_IDLE_TIMEOUT_MINUTES=30
# Set true when serving over HTTPS (cookie only sent over TLS) — true on Render
SESSION_COOKIE_SECURE=false
# Set true behind a reverse proxy / load balancer (Render) so per-IP login
# limits use the real client address instead of the proxy's
TRUST_PROXY_HEADERS=false

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (empty = same-origin only).
# For local dev: http://localhost:8000
# For production: https://yourdomain.com
ALLOWED_ORIGINS=

# ── Security ──────────────────────────────────────────────────────────────
# Disable API documentation endpoints (/docs, /redoc) in production
ENABLE_API_DOCS=false

# ── Public URL (used in emailed links) ────────────────────────────────────
# e.g. https://your-app.onrender.com
PUBLIC_BASE_URL=

# ── Optional: email delivery ──────────────────────────────────────────────
# Without SMTP, emails wait in the outbox (Super Admin → Messaging) and
# invitation / password-reset links are shown ONCE to the admin who created
# them. Super Admin → Global Settings → Email & alerts shows what is missing,
# ready-made lines for Hostinger / Gmail / Zoho / Brevo, and a test button.
# SMTP_SECURITY: ssl (port 465: Hostinger, Zoho) | starttls (port 587: Gmail,
# Outlook, Brevo) | none | auto (default: ssl on 465, starttls otherwise).
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl
# SMTP_USER=you@yourdomain.com
# SMTP_PASSWORD=
# SMTP_FROM=LeadAI <you@yourdomain.com>

# ── Optional: payments (Razorpay and/or Stripe) ───────────────────────────
# Keys live ONLY here (they can't be viewed or changed in the app). Which
# provider takes payments is chosen in Super Admin → Global Settings →
# Payments ("auto" = Razorpay when its keys are set, else Stripe, else the
# test-only mock checkout). A provider whose keys are missing is never used.
# Whatever the provider, a paid subscription only activates the organization
# after the Super Admin confirms it. Check the keys in Super Admin → Payments.
#
# Razorpay: Dashboard → Account & Settings → API keys (rzp_test_… / rzp_live_…)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks → Add: URL <PUBLIC_BASE_URL>/api/billing/webhook/razorpay,
# a secret of your choice (put it here), events: payment.captured, payment.failed,
# order.paid, refund.processed, payment.dispute.created
# RAZORPAY_WEBHOOK_SECRET=
#
# Stripe: Dashboard → Developers → API keys (sk_test_… / sk_live_…)
# STRIPE_SECRET_KEY=
# Stripe Dashboard → Developers → Webhooks → Add endpoint:
# <PUBLIC_BASE_URL>/api/billing/webhook/stripe, events: checkout.session.completed,
# checkout.session.async_payment_failed, invoice.paid, invoice.payment_failed,
# charge.refunded, charge.dispute.created, customer.subscription.deleted;
# paste its signing secret (whsec_…) here
# STRIPE_WEBHOOK_SECRET=
#
# Only used while Global Settings → Payments is "auto": force razorpay /
# stripe / mock (a provider without keys is skipped).
# BILLING_PROVIDER=
# The mock checkout (only when no provider has keys); false turns it off.
# MOCK_PAYMENTS_ENABLED=true

# ── Optional: business domain for branding ────────────────────────────────
# Reference only. The industry used for lead analysis is chosen per
# organization (Org Admin → Organization → Business profile).
# BUSINESS_DOMAIN=yourdomain.com
