# ── Google Gemini API (AI comment analysis) ──────────────────────────────
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

# ── MongoDB ──────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=LeadAI

# ── Apify (social data source) ───────────────────────────────────────────
# From https://apify.com/account/integrations
APIFY_API_TOKEN=

# ── Optional: non-Facebook platform actors (URL search) ──────────────────
# Leave empty to disable that platform.
INSTAGRAM_ACTOR_ID=apify/instagram-scraper
YOUTUBE_ACTOR_ID=streamers/youtube-scraper
LINKEDIN_ACTOR_ID=harvestapi/linkedin-company
LINKEDIN_POSTS_ACTOR_ID=harvestapi/linkedin-company-posts

# ── Server ────────────────────────────────────────────────────────────────
API_PORT=8000

# ── Admin sign-in (locks the whole app) ───────────────────────────────────
# The dashboard and every /api call require this login.
ADMIN_EMAIL=admin@gmail.com
# sha256 hash of the password (default = Admin@2026).
# Generate for a custom password: `python -c "import hashlib;print(hashlib.sha256(b'YourPass').hexdigest())"`
ADMIN_PASSWORD_HASH=a36aef5a11c4073fbe60314fc9df530a9d5f986533594d1f5190742ff9e0e408
# Long random string used to sign the session cookie (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
SESSION_SECRET=
# Session lifetime in days
SESSION_TTL_DAYS=7
# Set true when serving over HTTPS (cookie only sent over TLS)
SESSION_COOKIE_SECURE=false
