# ── Google Gemini API (AI intent parsing + comment analysis) ─────────────
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

# ── Business context (feeds the AI analysis prompt) ─────────────────────
BUSINESS_DOMAIN=general B2B services

# ── MongoDB ──────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=LeadAI

# ── Apify (Facebook data source #1) ──────────────────────────────────────
# From https://apify.com/account/integrations
APIFY_API_TOKEN=

# ── Bright Data (Facebook data source #2 — optional) ─────────────────────
# From https://brightdata.com/cp/setting/users
# Used when the search provider toggle is set to "Bright Data".
BRIGHTDATA_API_KEY=
# Dataset IDs — only override if Bright Data assigns you different ones.
BRIGHTDATA_DATASET_PAGES=gd_mf124a0511bauquyow
BRIGHTDATA_DATASET_POSTS=gd_lkaxegm826bjpoo9m5
BRIGHTDATA_DATASET_COMMENTS=gd_lkay758p1eanlolqw8

# ── Server ────────────────────────────────────────────────────────────────
API_PORT=8000
