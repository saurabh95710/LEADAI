# ── Google Gemini API (AI comment analysis) ──────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── MongoDB ──────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=LeadAI
# Comma-separated DNS servers for mongodb+srv:// SRV resolution (optional)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ── Apify (social data source) ───────────────────────────────────────────
# From https://apify.com/account/integrations
APIFY_API_TOKEN=

# ── Optional: non-Facebook platform actors (URL search) ──────────────────
# Leave empty to disable that platform.
INSTAGRAM_ACTOR_ID=apify/instagram-scraper
YOUTUBE_ACTOR_ID=streamers/youtube-scraper
LINKEDIN_ACTOR_ID=harvestapi/linkedin-company
LINKEDIN_POSTS_ACTOR_ID=harvestapi/linkedin-company-posts

# ── Optional: comment collection limits ──────────────────────────────────
# Maximum comments to collect per URL-search run (default: 100)
# MAX_COMMENTS_TO_COLLECT=100

# ── Server ────────────────────────────────────────────────────────────────
API_PORT=8000

# ══ SUPER ADMIN — PERMANENT PLATFORM OWNER (REQUIRED) ═════════════════════
# The ONLY login credentials configured through the environment. On Render,
# set both under your service → Environment. They sign in to /superadmin
# (at /login?superadmin=1) and are read from the environment only: they
# cannot be changed, reset or overridden from inside the app.
#   SUPERADMIN_PASSWORD: a long, unique password (12+ characters), or a
#   bcrypt hash of it ($2b$...), created with:
#   python -c "from app.auth.crypto import hash_password; print(hash_password('YourPassword'))"
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ── Admins and users: NOT configured here ─────────────────────────────────
# Organization admins, managers, users and viewers are database accounts,
# created through demo signup and invitation links (Super Admin portal →
# Organizations, or Org Admin portal → Team). Never add their emails or
# passwords as environment variables.

# ── Deprecated (optional, leave empty on new deployments) ─────────────────
# PANEL_ADMIN_EMAIL / PANEL_ADMIN_PASSWORD_HASH: old name for the Super
# Admin, used only when SUPERADMIN_EMAIL is not set.
# ADMIN_EMAIL / ADMIN_PASSWORD_HASH: old single-site login. If set, the
# startup migration copies the hash onto that user's database account once;
# sign-in itself is database-only, so you can remove them afterwards.
# PANEL_ADMIN_EMAIL=
# PANEL_ADMIN_PASSWORD_HASH=
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=

# ── Session security ──────────────────────────────────────────────────────
# Long random string used to sign session cookies.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# REQUIRED for production — without it sessions invalidate on every restart.
SESSION_SECRET=
# Session lifetime in days
SESSION_TTL_DAYS=7
# Set true when serving over HTTPS (cookie only sent over TLS) — true on Render
SESSION_COOKIE_SECURE=false
# Set true behind a reverse proxy / load balancer (Render) so per-IP login
# limits use the real client address instead of the proxy's
TRUST_PROXY_HEADERS=false

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (empty = same-origin only).
# For local dev: http://localhost:8000
# For production: https://yourdomain.com
ALLOWED_ORIGINS=

# ── Security ──────────────────────────────────────────────────────────────
# Disable API documentation endpoints (/docs, /redoc) in production
ENABLE_API_DOCS=false

# ── Optional: business domain for branding ────────────────────────────────
# BUSINESS_DOMAIN=yourdomain.com
